# Shared/global — used for compose-file variable substitution (build args,
# nginx template vars). Copy to .env (gitignored). Both PHP_VERSION_* live
# here together (not split into prod.env/dev.env) because both need to be
# present regardless of which environment's deploy is running.
PHP_VERSION_PROD=8.3
PHP_VERSION_DEV=8.3
NGINX_ADMIN_IP=203.0.113.4
OCI_BACKUP_BUCKET=wp-backups
PROD_HOST=shop.example.com
DEV_HOST=dev.shop.example.com
