resolver 127.0.0.11 valid=10s;

# ----------------------------------------------------------------------
# 1. HTTP -> HTTPS Redirect
# ----------------------------------------------------------------------
server {
    listen 80;
    server_name _;
    return 301 https://$host$request_uri;
}

# ----------------------------------------------------------------------
# www is a DNS/cert alias only; always redirect to the canonical APP_HOST.
# ----------------------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name www.${APP_HOST};

    ssl_certificate     /etc/nginx/certs/cloudflare-origin.pem;
    ssl_certificate_key /etc/nginx/certs/cloudflare-origin.key;

    return 301 https://${APP_HOST}$request_uri;
}

# ----------------------------------------------------------------------
# 2. Main HTTPS Server Block
# ----------------------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name ${APP_HOST} ${APP_HOST_ALIASES};
    root /var/www/html;
    index index.php;

    ssl_certificate     /etc/nginx/certs/cloudflare-origin.pem;
    ssl_certificate_key /etc/nginx/certs/cloudflare-origin.key;

    client_max_body_size 64M;

    # Block sensitive hidden/config files early
    location ~* \.(log|ini|sh)$ { deny all; }
    location = /xmlrpc.php { deny all; }

    # Static assets: Serve directly or 404. Prevents missing files falling back to PHP
    location ~* \.(css|js|jpg|jpeg|gif|png|ico|svg|webp|woff|woff2|ttf|eot)$ {
        try_files $uri =404;
        expires 30d;
        access_log off;
        add_header Cache-Control "public, no-transform";
    }

    # Standard WordPress routing
    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    # Whitelist admin-ajax.php for plugins, frontend checkout, and Printify hooks
    location = /wp-admin/admin-ajax.php {
        try_files $uri =404;
        fastcgi_pass php:9000;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_read_timeout 120s;
        fastcgi_send_timeout 120s;
    }

    # Protect wp-admin and wp-login by IP
    location ~* ^/(wp-login\.php|wp-admin) {
        allow ${NGINX_ADMIN_IP};
        deny all;

        # Allow assets for wp-admin without running PHP
        location ~* \.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
            try_files $uri =404;
            expires max;
            log_not_found off;
        }

        location ~ \.php$ {
            try_files $uri =404;
            fastcgi_pass php:9000;
            fastcgi_index index.php;
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_read_timeout 120s;
            fastcgi_send_timeout 120s;
            fastcgi_buffers 16 16k;
            fastcgi_buffer_size 32k;
        }
    }

    # General PHP execution (Storefront, REST API, Webhooks)
    location ~ \.php$ {
        # Note: Ensure limit_req_zone is defined in your http{} block
        limit_req zone=php_limit burst=20 nodelay;

        try_files $uri =404;
        fastcgi_pass php:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_read_timeout 120s;
        fastcgi_send_timeout 120s;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
    }
}