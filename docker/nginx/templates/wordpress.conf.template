include /etc/nginx/conf.d/security.conf;

# Docker's internal DNS lets nginx start even while either isolated WordPress
# stack is stopped. A request to a stopped environment returns 502; the other
# hostname continues to be served normally.
resolver 127.0.0.11 valid=10s;

server {
    listen 80;
    server_name _;
    return 301 https://$host$request_uri;
}

# ---- PROD ----
server {
    listen 443 ssl;
    http2 on;
    server_name ${PROD_HOST};
    root /var/www/prod;
    index index.php;

    ssl_certificate     /etc/nginx/certs/cloudflare-origin.pem;
    ssl_certificate_key /etc/nginx/certs/cloudflare-origin.key;

    client_max_body_size 32M;

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        set $php_upstream php-prod:9000;
        fastcgi_pass $php_upstream;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }

    location ~* ^/(wp-login\.php|wp-admin) {
        # Cloudflare's WAF custom rule is the primary lock (edge-level).
        # This origin-level lock with the same admin IP still holds even
        # against a direct hit to the OCI public IP, bypassing Cloudflare.
        allow ${NGINX_ADMIN_IP};
        deny all;
    }

    location ~* \.(log|ini|sh)$ { deny all; }
    location = /xmlrpc.php { deny all; }
}

# ---- DEV: your safe space to test PHP/WordPress upgrades and new plugins
# before they touch prod. Own doc root, own PHP-FPM, own database — nothing
# here can affect prod except shared network egress/bandwidth. ----
server {
    listen 443 ssl;
    http2 on;
    server_name ${DEV_HOST};
    root /var/www/dev;
    index index.php;

    ssl_certificate     /etc/nginx/certs/cloudflare-origin.pem;
    ssl_certificate_key /etc/nginx/certs/cloudflare-origin.key;

    client_max_body_size 32M;

    # Keep dev out of search results — it's a test box, not a second storefront.
    add_header X-Robots-Tag "noindex, nofollow" always;

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        set $php_upstream php-dev:9000;
        fastcgi_pass $php_upstream;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }

    location ~* ^/(wp-login\.php|wp-admin) {
        allow ${NGINX_ADMIN_IP};
        deny all;
    }

    location ~* \.(log|ini|sh)$ { deny all; }
    location = /xmlrpc.php { deny all; }
}
