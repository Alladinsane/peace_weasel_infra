# Copy to dev.env (gitignored). Deliberately a fully separate DB/user from
# prod.env — this is what makes dev an actually-safe place to break things.
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=wordpress_dev
MYSQL_USER=wp_dev
MYSQL_PASSWORD=change_me

WORDPRESS_DB_HOST=db-dev
WORDPRESS_DB_NAME=wordpress_dev
WORDPRESS_DB_USER=wp_dev
WORDPRESS_DB_PASSWORD=change_me
WORDPRESS_TABLE_PREFIX=wp_
