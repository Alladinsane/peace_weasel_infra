# Copy to prod.env (gitignored). Same var appears twice under two naming
# conventions on purpose: MYSQL_* is what the mariadb image expects,
# WORDPRESS_DB_* is what the wordpress/php-fpm image expects — both
# containers load this same file and each just reads what it needs.
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=wordpress_prod
MYSQL_USER=wp_prod
MYSQL_PASSWORD=change_me

WORDPRESS_DB_HOST=db-prod
WORDPRESS_DB_NAME=wordpress_prod
WORDPRESS_DB_USER=wp_prod
WORDPRESS_DB_PASSWORD=change_me
WORDPRESS_TABLE_PREFIX=wp_
