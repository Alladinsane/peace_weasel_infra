# Copy to terraform.tfvars (gitignored). Only ONE of these exists now —
# this provisions the single host that runs both dev and prod.
tenancy_ocid     = "ocid1.tenancy.oc1..xxxxx"
user_ocid        = "ocid1.user.oc1..xxxxx"
fingerprint      = "xx:xx:xx:...:xx"
private_key_path = "~/.oci/oci_api_key.pem"
region           = "us-ashburn-1"
compartment_ocid = "ocid1.compartment.oc1..xxxxx"

instance_ocpus     = 4
instance_memory_gb = 24

ssh_public_key_  = "ssh-ed25519 AAAA... admin-key"
admin_ssh_cidr = "203.0.113.4/32" # YOUR ip, not 0.0.0.0/0

git_repo_url    = "https://github.com/YOUR_USER/YOUR_REPO.git"
git_repo_branch = "main"
