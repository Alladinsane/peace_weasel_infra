# Copy to state.backend.hcl (gitignored). Replace the placeholders with your
# OCI Object Storage details. Terraform reads AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY from the environment; do not put them here.
bucket                      = "wp-terraform-state"
key                         = "oci/terraform.tfstate"
region                      = "us-ashburn-1"
endpoints                   = { s3 = "https://<object-storage-namespace>.compat.objectstorage.us-ashburn-1.oraclecloud.com" }
skip_requesting_account_id  = true